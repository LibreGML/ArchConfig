{
  /* ==================== 基础编辑器行为 ==================== */
  "autosave": 30,                    // 每30秒自动保存（单位：秒，0为禁用）
  "autosu": true,                    // 使用sudo保存无权限文件
  "backup": true,                    // 保存时创建备份文件（filename~）
  "basename": true,                  // 状态栏显示完整文件路径
  "colorcolumn": 80,                 // 在第80列显示参考线
  "colorscheme": "catppuccin-mocha-transparent",
  "cursorline": true,                // 高亮当前行
  "diffgutter": true,                // 显示Git差异标记（需启用diff插件）
  "eofnewline": true,                // 确保文件以换行符结束
  "ftoptions": true,                 // 启用文件类型特定选项
  "ignorecase": true,               // 搜索时不要区分大小写
  "indentchar": " ",                 // 使用空格作为缩进字符
  "infobar": true,                   // 显示顶部信息栏
  "keepautoindent": true,            // 换行时保持自动缩进
  "matchbrace": true,                // 高亮匹配的括号
  "mkparents": true,                 // 保存时自动创建不存在的父目录
  "mouse": true,                     // 启用鼠标支持
  "paste": true,                     // 启用终端粘贴模式检测
  "rmtrailingws": false,             // 关闭自动删除行尾空格
  "ruler": true,                     // 在状态栏显示行列号
  "savecursor": true,                // 重新打开文件时恢复光标位置
  "savehistory": true,               // 保存命令历史
  "syntax": true,                    // 启用语法高亮
  "tabmovement": false,              // Tab键用于缩进，而非移动焦点
  "tabstospaces": true,              // 按Tab键时插入空格
  "tabsize": 4,                      // 一个Tab等于4个空格
  "wordwrap": false,                 // 禁用单词折行  
  "scrollbar": true,                // 启用滚动条显示
  "softwrap": false,    

  /* ==================== Hyprland (Wayland) 剪贴板集成 ==================== */
  "clipboard": "external",           // 使用外部剪贴板工具
  "copycommand": "wl-copy",          // 复制命令（Hyprland/Wayland环境）
  "pastecommand": "wl-paste --no-newline", // 粘贴命令，去除末尾多余的换行

  /* ==================== 文件类型特定缩进设置 ==================== */
  "*.java": {
    "tabsize": 4,
    "tabstospaces": true
  },
  "*.xml": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.json": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.yaml": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.yml": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.py": {
    "tabsize": 4,
    "tabstospaces": true
  },
  "*.js": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.ts": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.html": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.css": {
    "tabsize": 2,
    "tabstospaces": true
  },
  "*.md": {
    "tabsize": 2,
    "tabstospaces": true,
    "softwrap": true,                 
    "wordwrap": true
  },

  /* ==================== 插件配置 ==================== */
  "autofmt": {
    "formatonsave": true,            
  },
  "quoter": {
    "enable": true              
  },
  "lsp":{
    "enabled": true,
  },
  "quickfix": {
    "enable": true
  },
  "snippets": {
    "enable": true
  }

}
